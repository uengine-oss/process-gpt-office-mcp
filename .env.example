# ============================================================
# 인프라 (Supabase / Memento)
# ============================================================
SUPABASE_URL=
SUPABASE_KEY=
MEMENTO_SERVICE_URL=http://memento-service:8005
MEMENTO_DRIVE_FOLDER_ID=

# ============================================================
# API Keys
# ============================================================
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# ============================================================
# LLM Provider 선택 (이 한 줄만 바꾸면 전환)
#   값: openai | openrouter | gemini | custom
# ============================================================
LLM_PROVIDER=openrouter

# ─── provider별 모델명 (네임스페이스 분리) ───
OPENAI_LLM_MODEL=gpt-5.1
OPENROUTER_LLM_MODEL=openai/gpt-oss-120b
GEMINI_LLM_MODEL=gemini-3.1-flash-image-preview

# ─── custom provider (폐쇄망) ───
CUSTOM_LLM_MODEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# ─── LLM 공통 ───
LLM_TIMEOUT_SECONDS=600
REASONING_EFFORT=low

# ============================================================
# 기능 On/Off
# ============================================================
LLM_VISION_ENABLED=false
WEB_SEARCH_ENABLED=false
IMAGE_GENERATION_ENABLED=false
IMAGE_REFERENCE_ENABLED=false
VISION_CHUNK_PLAN_ENABLED=false

# ============================================================
# 이미지 생성 (Gemini)
# ============================================================
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_IMAGE_TIMEOUT_SECONDS=120

# ============================================================
# 서버 / 외부 URL
# ============================================================
SERVER_PORT=1192
TAVILY_API_URL=https://api.tavily.com/search
